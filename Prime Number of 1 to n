namespace ConsoleApp10
{
    internal class Class1
    {
        static void Main()
        {
            int i, n, count;

            Console.Write("Enter a Number: ");
            n = int.Parse(Console.ReadLine());
            
            for(i = 2; i <= n; i++)
            {

                count = 0;
                for(int j = 1; j <= i; j++)
                {
                    if(i % j == 0)
                    {
                        count++;
                    }
                }

                if(count == 2)
                {
                    Console.Write(i + " ");

                }

            }
        }

    }
}
